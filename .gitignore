node_modules/
.tools/
.runtime/
.spacetime-data/
.env
.env.*
!.env.example
**/dist/
output/
*.log
*.tsbuildinfo
__pycache__/
.playwright-cli/
apps/*/public/assets/
apps/*/public/docs/
apps/*/public/reference/
apps/*/public/PIVOT.md
apps/*/public/help/
# Blender autosaves are recoverable local work, not selected source revisions.
*.blend1
*.blend2

# Each app stages these from the shared reviewed celestial asset source.
apps/*/public/reviewed-planets/
apps/*/public/reviewed-stars/

# Review evidence, reference boards and screenshots live in the Sidereal wiki and, as exact
# originals, in /root/sidereal-art-archive (docs/archived-media.json). T3 re-hashes every
# tracked file on each turn, so keep this media out of git. output/ above is scratch too.
reference/art/
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.webp
docs/**/*.gif
docs/**/*.webm
docs/**/*.mp4

# Agent runtimes: per-session worktrees and local settings (project skills in .claude/skills are tracked).
.claude/worktrees/
**/.claude/settings.local.json
# Isolated review/test servers started from a worktree.
.spacetime-data*/
# Generated art-library indexes and design pages (scripts/art_catalog.py); the wiki carries them.
assets/art-library/INDEX.md
assets/art-library/SOURCE_AUDIT.md
assets/art-library/FACIAL_REFERENCE_INDEX.md
assets/art-library/character-components/INDEX.md
assets/art-library/designs/*/DESIGN.md
# Documents and review media never go in git (scripts/check_docs.py enforces it in CI):
# write a wiki page; put exact originals in /root/sidereal-art-archive and scratch in output/.
docs/**/*.md
!docs/public/*.md
docs/handoffs/
reference/
*.mp4
*.webm
*.mov
