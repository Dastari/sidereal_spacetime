+              <text x={px(s.x) + 9} y={py(s.y)} fontSize={13}>
+                {s.name}
+              </text>
+            </g>
+          ))}
+        {layers.fields &&
+          tool === "direct" &&
+          mapZones(doc)
+            .filter((f) => f.id === selection && f.shape === "polygon")
+            .flatMap((f) =>
+              f.vertices.map((v, i) => {
