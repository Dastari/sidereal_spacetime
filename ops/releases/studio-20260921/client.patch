+    y = p.y - f.y,
+    h = p.height - f.height;
+  if (Math.abs(h) > f.depth / 2) return false;
+  if (f.shape === "ellipsoid")
+    return (
+      ((2 * x) / f.width) ** 2 +
+        ((2 * y) / f.length) ** 2 +
+        ((2 * h) / f.depth) ** 2 <=
+      1
+    );
+  if (f.shape === "polygon")
+    return insidePolygon(
+      { x, y },
+      f.vertices.some((v) => v.in || v.out)
+        ? compileZonePath(f.vertices)
