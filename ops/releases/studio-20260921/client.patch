+export function fieldVolume(f: AsteroidField) {
+  return f.shape === "ellipsoid"
+    ? (Math.PI / 6) * f.width * f.length * f.depth
+    : f.shape === "box"
+      ? f.width * f.length * f.depth
+      : polygonArea(
+          f.vertices.some((v) => v.in || v.out)
+            ? compileZonePath(f.vertices)
+            : f.vertices,
+        ) * f.depth;
