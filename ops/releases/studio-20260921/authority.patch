+  doc,
+  ships,
+  asteroids,
+  selection,
+  onSelect,
+  onMove,
+  onVertex,
+  tool,
+  selections,
+  pointIndex,
+  onPointSelect,
+  onHandle,
+  onInsert,
+  onMarquee,
+  cancelToken,
+  camera,
+  setCamera,
+  layers,
+  previewHeight,
+  drawing,
+  onDraw,
+}: {
+  doc: SystemMapDocument;
+  ships: MapShip[];
+  asteroids: FieldAsteroid[];
+  selection: string;
+  onSelect: (id: string, additive?: boolean) => void;
+  selections: string[];
+  tool: "select" | "direct" | "pan";
+  pointIndex: number | null;
+  cancelToken: number;
+  onPointSelect: (i: number) => void;
+  onHandle: (
+    id: string,
+    index: number,
+    side: "in" | "out",
+    x: number,
+    y: number,
+    independent: boolean,
+  ) => void;
+  onInsert: (id: string, index: number, t: number) => void;
+  onMarquee: (ids: string[], additive: boolean) => void;
+  onMove: (id: string, x: number, y: number) => void;
+  onVertex: (id: string, index: number, x: number, y: number) => void;
+  camera: Camera;
+  setCamera: (c: Camera) => void;
+  layers: {
+    bodies: boolean;
+    ships: boolean;
+    fields: boolean;
+    grid: boolean;
+    orbits: boolean;
+  };
