+    ).toThrow(/Genesis/);
+    expect(f.db.systemBody.id.find("planet")).toEqual(f.body);
+    expect([...f.db.systemMapEdit.iter()]).toHaveLength(0);
+  }
+  const f = genesisFixture();
+  f.db.shipWorldMotion.insert({
+    shipId: "ship",
